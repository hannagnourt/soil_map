<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- Expand/collapse icon -->
    <ImageView
        android:id="@+id/imageView_expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Expand/Collapse" />

    <!-- Layer name -->

    <!-- Layer visibility button -->

    <TextView
        android:id="@+id/textView_layer_name"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"
        android:text="Layer Name"
        android:textAlignment="center"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/layerVisibilitySwitch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"/>

    <!-- Layer customize button -->
    <ImageButton
        android:id="@+id/layerCustomizeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#00FFFFFF"
        android:layout_marginStart="5dp"
        android:src="@drawable/more" />
</LinearLayout>
