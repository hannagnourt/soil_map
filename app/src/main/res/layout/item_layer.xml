<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Expand/collapse icon -->
    <ImageView
        android:id="@+id/imageView_expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Expand/Collapse" />

    <!-- Layer name -->
    <TextView
        android:id="@+id/textView_layer_name"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Layer Name"
        android:textSize="16sp" />

    <!-- Layer visibility button -->
    <Switch
        android:id="@+id/layerVisibilitySwitch"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <!-- Layer customize button -->
    <ImageButton
        android:id="@+id/layerCustomizeButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:backgroundTint="#00FFFFFF"
        android:src="@drawable/more" />
</LinearLayout>
